.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Runtime data and private document-derived state
*.db
*.sqlite
*.sqlite3
*.rdb
*.aof
data/uploads/*
uploads/
storage/
qdrant_storage/
qdrant-data/
vectors/
embeddings/
traces/
conversations/
backups/
*.bak
*.backup
*.dump

# Keep only the empty upload-directory marker; all runtime contents remain ignored.
!data/uploads/
!data/uploads/.gitkeep

# Celery
celerybeat-schedule
celerybeat.pid

# Coverage
.coverage
coverage.xml
htmlcov/

# Logs
*.log
logs/
*.log.*

# Local-only planning notes may contain private context.
NOTES.md

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
