*.py[cod]
*.pyo
*.pyd
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
