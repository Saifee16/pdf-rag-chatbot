APP_NAME=PDF RAG Chatbot
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./rag.db

# Local Docker Compose defaults. Replace credentials outside local development.
POSTGRES_DB=pdf_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_chunks

STORAGE_DIR=./data/uploads
MAX_PDF_SIZE_MB=25
MAX_PDF_PAGES=5000
OCR_ENABLED=true
OCR_MIN_NATIVE_TEXT_CHARS=32
OCR_MAX_PAGES=50
OCR_TIMEOUT_SECONDS=30
OCR_DOCUMENT_TIMEOUT_SECONDS=900
OCR_DPI=200
OCR_LANGUAGES=eng
OCR_EXECUTABLE=tesseract

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
RETRIEVAL_ABSTENTION_ENABLED=true
RETRIEVAL_CONFIDENCE_THRESHOLD=0.50
RETRIEVAL_MODE=hybrid
HYBRID_DENSE_CANDIDATES=20
HYBRID_LEXICAL_CANDIDATES=20
RETRIEVAL_RRF_K=60
RERANKER_PROVIDER=deterministic
RERANK_CANDIDATES=20
CONVERSATION_HISTORY_MESSAGES=6

CHAT_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
CHAT_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Project 3 LLM Gateway integration for CHAT_PROVIDER=gateway.
GATEWAY_URL=http://localhost:8001
GATEWAY_API_KEY=
GATEWAY_MODEL_ALIAS=fast
PROVIDER_TIMEOUT_SECONDS=60

# Local/development defaults. APP_ENV=production refuses unsafe values for
# APP_DEBUG, API_AUTH_ENABLED, API_KEYS, and wildcard ALLOWED_HOSTS.
API_AUTH_ENABLED=false
API_KEYS=
CORS_ORIGINS=
ALLOWED_HOSTS=*

CELERY_TASK_ALWAYS_EAGER=false
RAG_SYSTEM_PROMPT_PATH=./prompts/rag_system.txt
